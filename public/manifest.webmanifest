{
  "name": "UWCheck",
  "short_name": "UWCheck",
  "description": "One calendar and to-do list for Canvas, Ed and UW course websites.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
